<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claudian - Obsidian Vault"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns="http://www.topografix.com/GPX/1/1"
 xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">

  <metadata>
    <name>Le Havre – Stationen für Tourenplanung</name>
    <desc>Wegpunkte der Sehenswürdigkeiten in Le Havre, als Klick-Vorlage für BRouter-Web. Keine fertige Route – Reihenfolge frei waehlbar.</desc>
    <author>
      <name>Claudian - Obsidian Vault</name>
    </author>
    <time>2026-08-17T00:00:00Z</time>
  </metadata>

  <!-- === Start === -->

  <wpt lat="49.48470" lon="0.10020">
    <name>00 Parkplatz Bd Clemenceau (kostenlos)</name>
    <desc>Kostenlose Laengsparkplaetze am Boulevard Clemenceau gegenueber dem Meer, ca. 200 m vom MuMa-Eingang (Hoehe Nr. 105). An Schoenwettertagen ab spaetem Vormittag voll - frueh da sein. Ausweichen: Parking Docks Vauban oder Espace Coty (beide kostenpflichtig, Tiefgarage).</desc>
    <sym>Parking Area</sym>
  </wpt>

  <!-- === Pflichtprogramm === -->

  <wpt lat="49.48247" lon="0.10327">
    <name>01 MuMa - Musee Malraux</name>
    <desc>2 bd Clemenceau. Di/Mi/Fr 11-18, Do 11-22, Sa/So 11-19, Mo zu. ca. 10 EUR, Kasse vor Ort. Parken in der Naehe moeglich - guter Startpunkt.</desc>
    <sym>Museum</sym>
  </wpt>

  <wpt lat="49.48380" lon="0.09870">
    <name>02 Catene de Containers</name>
    <desc>Containerbogen von Vincent Ganivet am Hafeneingang, 2017. Position grob - auf der Karte kontrollieren.</desc>
    <sym>Scenic Area</sym>
  </wpt>

  <wpt lat="49.49260" lon="0.09950">
    <name>03 Porte Oceane</name>
    <desc>Perrets Stadttor zum Meer, Achsenabschluss der Avenue Foch.</desc>
    <sym>Building</sym>
  </wpt>

  <wpt lat="49.49540" lon="0.09320">
    <name>04 Plage / Strandkabinen</name>
    <desc>Kiesstrand mit weissen Badekabinen, Promenade Richtung Sainte-Adresse.</desc>
    <sym>Beach</sym>
  </wpt>

  <wpt lat="49.49680" lon="0.09050">
    <name>05 Frites a Victor</name>
    <desc>Kultimbiss an der Promenade seit 1927. Saisonbetrieb, im August offen.</desc>
    <sym>Restaurant</sym>
  </wpt>

  <wpt lat="49.50430" lon="0.09400">
    <name>06 Jardins Suspendus</name>
    <desc>Festung des 19. Jh. auf der Klippe, Themengaerten + Gewaechshaeuser. Beste Aussicht ueber Stadt, Hafen und Seine-Muendung. Steiler Anstieg!</desc>
    <sym>Park</sym>
  </wpt>

  <wpt lat="49.49030" lon="0.10240">
    <name>07 Eglise Saint-Joseph</name>
    <desc>Perret, 107 m Betonturm als Lichtschacht, Glas von Marguerite Hure. Eintritt frei. Pflichtstation.</desc>
    <sym>Church</sym>
  </wpt>

  <wpt lat="49.49030" lon="0.10670">
    <name>08 Le Volcan</name>
    <desc>Oscar Niemeyer, 1982. Mediathek im Petit Volcan ist oeffentlich zugaenglich und kostenlos.</desc>
    <sym>Building</sym>
  </wpt>

  <wpt lat="49.48680" lon="0.10760">
    <name>09 Appartement temoin Perret</name>
    <desc>Maison du Patrimoine, 181 rue de Paris. NUR mit Fuehrung, ca. 1 Std. August taeglich 10:00 / 11:00 / 14:30 / 15:30 / 16:30. Anmeldung 02 35 22 31 22.</desc>
    <sym>Museum</sym>
  </wpt>

  <!-- === Ergaenzungen === -->

  <wpt lat="49.48810" lon="0.10850">
    <name>10 Cathedrale Notre-Dame</name>
    <desc>Renaissance, einer der wenigen Kriegsueberlebenden der Innenstadt.</desc>
    <sym>Church</sym>
  </wpt>

  <wpt lat="49.48670" lon="0.11050">
    <name>11 Maison de l'Armateur</name>
    <desc>3 quai de l'Ile. Reederhaus um 1790 mit oktogonalem Lichthof.</desc>
    <sym>Museum</sym>
  </wpt>

  <wpt lat="49.49380" lon="0.10780">
    <name>12 Hotel de Ville</name>
    <desc>Perret-Rathaus mit Turm, Hauptplatz des Wiederaufbaus.</desc>
    <sym>Building</sym>
  </wpt>

  <wpt lat="49.49220" lon="0.10920">
    <name>13 Les Halles Centrales</name>
    <desc>Markthallen, Mittagspause / Proviant.</desc>
    <sym>Shopping Center</sym>
  </wpt>

  <wpt lat="49.48450" lon="0.11750">
    <name>14 Docks Vauban</name>
    <desc>Backsteinlagerhaus von 1846, heute Einkaufszentrum mit Kino.</desc>
    <sym>Shopping Center</sym>
  </wpt>

  <wpt lat="49.48520" lon="0.11880">
    <name>15 Les Bains des Docks</name>
    <desc>Badelandschaft von Jean Nouvel, quai de la Reunion. Regentag-Option.</desc>
    <sym>Swimming Area</sym>
  </wpt>


</gpx>
