  <metadata>
    <name>Maastricht Kurztour – Altstadt (2-3h)</name>
    <desc>Kompakte Stadtrundgang mit 8 Highlights + Nimm North Caves Option</desc>
    <author>
      <name>Claudian - Obsidian Vault</name>
    </author>
    <time>2026-05-27T09:00:00Z</time>
  </metadata>

  <!-- Waypoints für alle Stationen (Kurztour) -->
  <wpt lat="50.8503" lon="5.6875">
    <name>1. Sint Servaasbrug (START)</name>
    <desc>Älteste Brücke der Niederlande, Startpunkt</desc>
    <sym>parking</sym>
  </wpt>

  <wpt lat="50.8504" lon="5.6895">
    <name>2. Sint Janskerk</name>
    <desc>Gotische Kirche mit grünen Türmen</desc>
    <sym>chapel</sym>
  </wpt>

  <wpt lat="50.8506" lon="5.6890">
    <name>3. Vrijthof Square</name>
    <desc>Hauptplatz mit Cafés - Kaffee-Stop!</desc>
    <sym>scenic</sym>
  </wpt>

  <wpt lat="50.8503" lon="5.6880">
    <name>4. Sint Servatiuskerk</name>
    <desc>Älteste Kirche (6. Jh.), Eintritt €5</desc>
    <sym>chapel</sym>
  </wpt>

  <wpt lat="50.8500" lon="5.6870">
    <name>5. Boekhandel Dominicanen</name>
    <desc>Wunderschöne Buchhandlung im Kloster</desc>
    <sym>scenic</sym>
  </wpt>

  <wpt lat="50.8495" lon="5.6875">
    <name>6. Markt (Markplatz)</name>
    <desc>Traditioneller Markt, Mi & Sa</desc>
    <sym>scenic</sym>
  </wpt>

  <wpt lat="50.8480" lon="5.6880">
    <name>7. Helpoort</name>
    <desc>Ältestes Stadttor der Niederlande (13. Jh.)</desc>
    <sym>scenic</sym>
  </wpt>

  <wpt lat="50.8555" lon="5.6885">
    <name>8. Nimm North Caves (Optional - UNESCO)</name>
    <desc>UNESCO-Höhlen, Geführte Tour 45min, €12,50</desc>
    <sym>scenic</sym>
  </wpt>

