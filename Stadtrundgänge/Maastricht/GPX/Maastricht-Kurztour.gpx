<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claudian - Obsidian Vault"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns="http://www.topografix.com/GPX/1/1"
